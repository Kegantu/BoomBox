{
	"schemaVersion": 1,
	"id": "boombox",
	"version": "${version}",
	"name": "BoomBox",
	"description": "A Minecraft mod that adds a boombox that let's you play music from youtube",
	"authors": [
		"Kegantu"
	],
	"contact": {
		"issues": "https://github.com/Kegantu/BoomBox/issues",
		"sources": "https://github.com/Kegantu/BoomBox"
	},
	"license": "CC0-1.0",
	"icon": "assets/boombox/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.kegantu.boombox.BoomBox"
		],
		"fabric-datagen": [
			"me.kegantu.boombox.BoomBoxDataGenerator"
		],
		"client": [
			"me.kegantu.boombox.client.BoomBoxClient"
		]
	},
	"mixins": [
		"boombox.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	},
	"accessWidener": "boombox.accesswidener"
}